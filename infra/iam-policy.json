{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VozarioWebS3",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REEMPLAZAR_BUCKET/*"
    },
    {
      "Sid": "VozarioWebTranscribe",
      "Effect": "Allow",
      "Action": [
        "transcribe:StartTranscriptionJob",
        "transcribe:GetTranscriptionJob",
        "transcribe:DeleteTranscriptionJob"
      ],
      "Resource": "*"
    }
  ]
}

